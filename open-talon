#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_DIR="${ROOT_DIR}/.run"
GATEWAY_PID_FILE="${RUN_DIR}/gateway-edge.pid"
GATEWAY_LOG_FILE="${RUN_DIR}/gateway-edge.log"
AGENT_TASK_PID_FILE="${RUN_DIR}/agent-task-worker.pid"
AGENT_TASK_LOG_FILE="${RUN_DIR}/agent-task-worker.log"
AGENT_LOOP_PID_FILE="${RUN_DIR}/agent-loop-worker.pid"
AGENT_LOOP_LOG_FILE="${RUN_DIR}/agent-loop-worker.log"
TOOL_WORKER_PID_FILE="${RUN_DIR}/tool-worker.pid"
TOOL_WORKER_LOG_FILE="${RUN_DIR}/tool-worker.log"
RETRIEVER_WORKER_PID_FILE="${RUN_DIR}/retriever-worker.pid"
RETRIEVER_WORKER_LOG_FILE="${RUN_DIR}/retriever-worker.log"
RECONCILER_PID_FILE="${RUN_DIR}/reconciler.pid"
RECONCILER_LOG_FILE="${RUN_DIR}/reconciler.log"
PYTHON_BIN="${ROOT_DIR}/.venv/bin/python"
INFRA_ENV_FILE="${ROOT_DIR}/infrastructure/.env"

mkdir -p "${RUN_DIR}"

load_local_env() {
  if [[ -f "${INFRA_ENV_FILE}" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "${INFRA_ENV_FILE}"
    set +a
  fi
  : "${OPEN_TALON_OIDC_ISSUER_URL:=http://127.0.0.1:8081/realms/open-talon}"
  : "${OPEN_TALON_OIDC_CLIENT_ID:=open-talon-tui}"
  : "${AUTH_MODE:=any}"
  : "${OIDC_ISSUER_URL:=${OPEN_TALON_OIDC_ISSUER_URL}}"
  : "${OIDC_CLIENT_ID_TUI:=${OPEN_TALON_OIDC_CLIENT_ID}}"
  : "${OIDC_AUDIENCE:=${OIDC_CLIENT_ID_TUI}}"
  export \
    OPEN_TALON_OIDC_ISSUER_URL \
    OPEN_TALON_OIDC_CLIENT_ID \
    AUTH_MODE \
    OIDC_ISSUER_URL \
    OIDC_CLIENT_ID_TUI \
    OIDC_AUDIENCE
}

ensure_python() {
  if [[ ! -x "${PYTHON_BIN}" ]]; then
    echo "Missing ${PYTHON_BIN}. Run ./scripts/bootstrap-python.sh first." >&2
    exit 1
  fi
}

repo_pythonpath() {
  local entries=(
    "${ROOT_DIR}/packages/contracts"
    "${ROOT_DIR}/services/core-collab"
    "${ROOT_DIR}/services/gateway-edge"
    "${ROOT_DIR}/services/agent-runtime"
    "${ROOT_DIR}/services/retriever"
    "${ROOT_DIR}/services/generated-tools-builder"
    "${ROOT_DIR}/services/workspace-memory"
    "${ROOT_DIR}/apps/tui"
  )
  local joined
  joined="$(IFS=:; echo "${entries[*]}")"
  if [[ -n "${PYTHONPATH:-}" ]]; then
    printf '%s:%s\n' "${joined}" "${PYTHONPATH}"
  else
    printf '%s\n' "${joined}"
  fi
}

valkey_password() {
  if [[ -n "${VALKEY_PASSWORD:-}" ]]; then
    printf '%s\n' "${VALKEY_PASSWORD}"
  elif [[ -n "${LANGFUSE_VALKEY_PASSWORD:-}" ]]; then
    printf '%s\n' "${LANGFUSE_VALKEY_PASSWORD}"
  else
    printf '%s\n' "langfuse-dev-secret"
  fi
}

pid_is_running() {
  local pid_file="$1"
  if [[ ! -f "${pid_file}" ]]; then
    return 1
  fi
  local pid
  pid="$(cat "${pid_file}")"
  kill -0 "${pid}" >/dev/null 2>&1
}

start_python_module() {
  local name="$1"
  local module="$2"
  local pid_file="$3"
  local log_file="$4"
  local pythonpath="$5"
  if pid_is_running "${pid_file}"; then
    echo "${name} already running with PID $(cat "${pid_file}")."
    return
  fi
  rm -f "${pid_file}"
  echo "Starting local ${name}..."
  local pid
  pid="$(
    PYTHONPATH="${pythonpath}" \
    ROOT_DIR="${ROOT_DIR}" \
    LOG_FILE="${log_file}" \
    MODULE="${module}" \
    PYTHON_BIN="${PYTHON_BIN}" \
    OPEN_TALON_DEFAULT_WORKSPACE_PATH="${OPEN_TALON_DEFAULT_WORKSPACE_PATH:-${ROOT_DIR}}" \
    "${PYTHON_BIN}" - <<'PY'
import os
import subprocess

proc = subprocess.Popen(
    [
        os.environ["PYTHON_BIN"],
        "-m",
        "open_talon_contracts.log_relay",
        "--log-file",
        os.environ["LOG_FILE"],
        "--cwd",
        os.environ["ROOT_DIR"],
        "--",
        os.environ["PYTHON_BIN"],
        "-m",
        os.environ["MODULE"],
    ],
    cwd=os.environ["ROOT_DIR"],
    env=os.environ.copy(),
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    start_new_session=True,
    close_fds=True,
)
print(proc.pid)
PY
  )"
  echo "${pid}" > "${pid_file}"
}

stop_pid_file() {
  local name="$1"
  local pid_file="$2"
  if ! [[ -f "${pid_file}" ]]; then
    return
  fi
  local pid
  pid="$(cat "${pid_file}")"
  if kill -0 "${pid}" >/dev/null 2>&1; then
    echo "Stopping ${name} PID ${pid}..."
    kill "${pid}" >/dev/null 2>&1 || true
    wait "${pid}" 2>/dev/null || true
  fi
  rm -f "${pid_file}"
}

gateway_supports_current_api() {
  local pythonpath="$1"
  local url="${2:-http://localhost:8000/openapi.json}"
  PYTHONPATH="${pythonpath}" "${PYTHON_BIN}" - <<PY
import json
import sys
import urllib.request

try:
    with urllib.request.urlopen("${url}", timeout=2) as response:
        data = json.load(response)
    paths = data.get("paths", {})
    required = {
        "/v1/workspaces",
        "/v1/threads/{thread_id}/timeline",
        "/v1/threads/{thread_id}/events/stream",
    }
    raise SystemExit(0 if required.issubset(paths) else 1)
except Exception:
    raise SystemExit(1)
PY
}

oidc_issuer_ready() {
  local issuer_url="$1"
  local discovery_url="${issuer_url%/}/.well-known/openid-configuration"
  "${PYTHON_BIN}" - <<PY
import json
import sys
import urllib.request

try:
    with urllib.request.urlopen("${discovery_url}", timeout=2) as response:
        data = json.load(response)
    required = {"authorization_endpoint", "token_endpoint", "issuer"}
    raise SystemExit(0 if required.issubset(data) else 1)
except Exception:
    raise SystemExit(1)
PY
}

start_cmd() {
  ensure_python
  load_local_env
  local gateway_startup_wait_seconds="${OPEN_TALON_GATEWAY_STARTUP_WAIT_SECONDS:-60}"
  local oidc_startup_wait_seconds="${OPEN_TALON_OIDC_STARTUP_WAIT_SECONDS:-60}"
  local enable_memgraph=0
  while (($# > 0)); do
    case "$1" in
      --memgraph)
        enable_memgraph=1
        ;;
      *)
        echo "Unknown start option: $1" >&2
        usage
        exit 1
        ;;
    esac
    shift
  done
  local pythonpath
  pythonpath="$(repo_pythonpath)"

  echo "Starting infrastructure services..."
  (
    cd "${ROOT_DIR}/infrastructure"
    local services=(
      postgres
      pgadmin
      kafka
      valkey
      openbao
      openbao-init
      keycloak
      keycloak-init
      ollama
      clickhouse
      minio
      minio-init
      forgejo
      forgejo-init
      langfuse-db-init
      langfuse-worker
      langfuse-web
    )
    if ((enable_memgraph)); then
      services+=(memgraph)
    fi
    docker compose up -d "${services[@]}"
  )

  if [[ -f "${GATEWAY_PID_FILE}" ]]; then
    EXISTING_PID="$(cat "${GATEWAY_PID_FILE}")"
    if kill -0 "${EXISTING_PID}" >/dev/null 2>&1; then
      if gateway_supports_current_api "${pythonpath}"; then
        echo "Gateway already running with PID ${EXISTING_PID}."
      else
        echo "Restarting stale gateway-edge PID ${EXISTING_PID}..."
        kill "${EXISTING_PID}" >/dev/null 2>&1 || true
        wait "${EXISTING_PID}" 2>/dev/null || true
        rm -f "${GATEWAY_PID_FILE}"
      fi
    else
      rm -f "${GATEWAY_PID_FILE}"
    fi
  fi

  if pid_is_running "${GATEWAY_PID_FILE}"; then
    GATEWAY_PID="$(cat "${GATEWAY_PID_FILE}")"
  else
    echo "Starting local gateway-edge..."
    GATEWAY_PID="$(
    PYTHONPATH="${pythonpath}" ROOT_DIR="${ROOT_DIR}" LOG_FILE="${GATEWAY_LOG_FILE}" PYTHON_BIN="${PYTHON_BIN}" VALKEY_PASSWORD="$(valkey_password)" OPEN_TALON_DEFAULT_WORKSPACE_PATH="${OPEN_TALON_DEFAULT_WORKSPACE_PATH:-${ROOT_DIR}}" "${PYTHON_BIN}" - <<'PY'
import os
import subprocess

proc = subprocess.Popen(
    [
        os.environ["PYTHON_BIN"],
        "-m",
        "open_talon_contracts.log_relay",
        "--log-file",
        os.environ["LOG_FILE"],
        "--cwd",
        os.environ["ROOT_DIR"],
        "--",
        os.environ["PYTHON_BIN"],
        "-m",
        "uvicorn",
        "gateway_edge.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
    ],
    cwd=os.environ["ROOT_DIR"],
    env=os.environ.copy(),
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    start_new_session=True,
    close_fds=True,
)
print(proc.pid)
PY
    )"
    echo "${GATEWAY_PID}" > "${GATEWAY_PID_FILE}"
  fi

  for _ in $(seq 1 "${oidc_startup_wait_seconds}"); do
    if oidc_issuer_ready "${OPEN_TALON_OIDC_ISSUER_URL}"; then
      break
    fi
    sleep 1
  done

  if ! oidc_issuer_ready "${OPEN_TALON_OIDC_ISSUER_URL}"; then
    echo "OIDC issuer failed to become ready: ${OPEN_TALON_OIDC_ISSUER_URL}" >&2
    rm -f "${GATEWAY_PID_FILE}"
    exit 1
  fi

  for _ in $(seq 1 "${gateway_startup_wait_seconds}"); do
    sleep 1
    if gateway_supports_current_api "${pythonpath}"; then
      start_python_module \
        "agent-task-worker" \
        "agent_runtime.agent_task_worker" \
        "${AGENT_TASK_PID_FILE}" \
        "${AGENT_TASK_LOG_FILE}" \
        "${pythonpath}"
      start_python_module \
        "agent-loop-worker" \
        "agent_runtime.agent_loop_worker" \
        "${AGENT_LOOP_PID_FILE}" \
        "${AGENT_LOOP_LOG_FILE}" \
        "${pythonpath}"
      start_python_module \
        "tool-worker" \
        "agent_runtime.tool_worker" \
        "${TOOL_WORKER_PID_FILE}" \
        "${TOOL_WORKER_LOG_FILE}" \
        "${pythonpath}"
      start_python_module \
        "reconciler" \
        "agent_runtime.reconciler" \
        "${RECONCILER_PID_FILE}" \
        "${RECONCILER_LOG_FILE}" \
        "${pythonpath}"
      start_python_module \
        "retriever-worker" \
        "retriever.worker" \
        "${RETRIEVER_WORKER_PID_FILE}" \
        "${RETRIEVER_WORKER_LOG_FILE}" \
        "${pythonpath}"
      echo "Gateway PID: ${GATEWAY_PID}"
      echo "Gateway log: ${GATEWAY_LOG_FILE}"
      return
    fi
    if ! kill -0 "${GATEWAY_PID}" >/dev/null 2>&1; then
      break
    fi
  done

  echo "Gateway failed to start correctly. See ${GATEWAY_LOG_FILE}" >&2
  rm -f "${GATEWAY_PID_FILE}"
  exit 1
}

stop_cmd() {
  load_local_env
  stop_pid_file "retriever-worker" "${RETRIEVER_WORKER_PID_FILE}"
  stop_pid_file "reconciler" "${RECONCILER_PID_FILE}"
  stop_pid_file "tool-worker" "${TOOL_WORKER_PID_FILE}"
  stop_pid_file "agent-loop-worker" "${AGENT_LOOP_PID_FILE}"
  stop_pid_file "agent-task-worker" "${AGENT_TASK_PID_FILE}"
  stop_pid_file "gateway-edge" "${GATEWAY_PID_FILE}"

  echo "Stopping infrastructure services..."
  (
    cd "${ROOT_DIR}/infrastructure"
    docker compose down
  )
}

tui_cmd() {
  ensure_python
  load_local_env
  local pythonpath
  pythonpath="$(repo_pythonpath)"
  exec env PYTHONPATH="${pythonpath}" "${PYTHON_BIN}" -m open_talon_tui.main --gateway http://127.0.0.1:8000 "$@"
}

tui2_cmd() {
  ensure_python
  load_local_env
  local pythonpath
  pythonpath="$(repo_pythonpath)"
  exec env PYTHONPATH="${pythonpath}" "${PYTHON_BIN}" -m open_talon_tui.tui2 --gateway http://127.0.0.1:8000 "$@"
}

user_client_cmd() {
  ensure_python
  load_local_env
  local pythonpath
  pythonpath="$(repo_pythonpath)"
  exec env PYTHONPATH="${pythonpath}" "${PYTHON_BIN}" -m open_talon_tui.user_client --gateway http://127.0.0.1:8000 "$@"
}

usage() {
  cat <<EOF
Usage:
  ./open-talon init [--memgraph] [--wait-seconds seconds]
  ./open-talon repair [--no-start] [--memgraph] [--skip-identities]
  ./open-talon reset --yes [--init] [--include-models] [--memgraph]
  ./open-talon start [--memgraph]
  ./open-talon stop
  ./open-talon tui [extra tui args]
  ./open-talon tui auth login [auth args]
  ./open-talon tui2 [extra tui2 args]
  ./open-talon tui2 auth login [auth args]
  ./open-talon user-client [extra client args]
  ./open-talon user-client auth login [auth args]
EOF
}

case "${1:-}" in
  init)
    shift
    exec "${ROOT_DIR}/scripts/system-init.sh" "$@"
    ;;
  repair)
    shift
    exec "${ROOT_DIR}/scripts/system-repair.sh" "$@"
    ;;
  reset)
    shift
    exec "${ROOT_DIR}/scripts/system-reset.sh" "$@"
    ;;
  start)
    shift
    start_cmd "$@"
    ;;
  stop)
    shift
    stop_cmd "$@"
    ;;
  tui)
    shift
    tui_cmd "$@"
    ;;
  tui2)
    shift
    tui2_cmd "$@"
    ;;
  user-client)
    shift
    user_client_cmd "$@"
    ;;
  *)
    usage
    exit 1
    ;;
esac
