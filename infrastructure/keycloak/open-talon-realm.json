{
  "realm": "open-talon",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "clients": [
    {
      "clientId": "open-talon-tui",
      "name": "Open Talon TUI",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "oauth2.device.polling.interval": "5"
      }
    },
    {
      "clientId": "open-talon-web",
      "name": "Open Talon Web",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5173",
        "http://127.0.0.1:*",
        "http://127.0.0.1:*/*",
        "http://localhost:5173",
        "http://localhost:*",
        "http://localhost:*/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173",
        "http://127.0.0.1:*",
        "http://localhost:5173",
        "http://localhost:*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
