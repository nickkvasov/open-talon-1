# Infrastructure Ports
POSTGRES_PORT=5432
KAFKA_PORT=9092
BAO_PORT=8200
VALKEY_PORT=6379
OLLAMA_PORT=11434

# PostgreSQL Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db

# OpenBao/Vault Configuration
BAO_ROOT_TOKEN=root

# Ollama Models (comma-separated list)
REQUIRED_MODELS=gemma4:latest,gemma4:e4b
