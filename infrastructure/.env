# Infrastructure Ports
POSTGRES_PORT=5432
PGADMIN_PORT=5050
KAFKA_PORT=9092
BAO_PORT=8200
VALKEY_PORT=6379
OLLAMA_PORT=11434

# PostgreSQL Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

# OpenBao/Vault Configuration
BAO_ROOT_TOKEN=root

# Local model roles. Ollama pulls the collected role models unless
# REQUIRED_MODELS is set as an explicit comma-separated override.
OPEN_TALON_DEFAULT_REASONING_MODEL=gemma4:31b
RETRIEVER_DEFAULT_EMBEDDING_MODEL=bge-m3:567m
RETRIEVER_DEFAULT_VISION_ENGINE_ID=local-ollama
RETRIEVER_DEFAULT_VISION_MODEL=gemma4:31b
REQUIRED_MODELS=

# Langfuse SDK Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-2b4c2bf8-4f66-4d8f-bdf0-334445d35526
LANGFUSE_SECRET_KEY=sk-lf-6f0739c7-94e3-448d-a88a-dfb8f54f6e7c
