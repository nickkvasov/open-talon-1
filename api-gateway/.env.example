# ── Gateway ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Comma-separated allowed CORS origins. Use * for all (dev only).
CORS_ORIGINS=*

# ── Auth ──────────────────────────────────────────────────────────
# Options: none | api_key | openbao | any
AUTH_MODE=none
# Comma-separated paths always exempt from auth
AUTH_SKIP_PATHS=/health,/ready,/docs,/openapi.json,/favicon.ico

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_MIN_POOL=2
POSTGRES_MAX_POOL=10

# ── Valkey / Redis ────────────────────────────────────────────────
VALKEY_HOST=localhost
VALKEY_PORT=6379
# VALKEY_PASSWORD=
VALKEY_DB=0
SESSION_TTL_SECONDS=86400

# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=senate.chat.requests
KAFKA_RESPONSE_TOPIC=senate.chat.responses
KAFKA_CONSUMER_GROUP=api-gateway
KAFKA_RESPONSE_TIMEOUT_SECONDS=120.0

# ── OpenBao ───────────────────────────────────────────────────────
OPENBAO_ADDRESS=http://localhost:8200
OPENBAO_ADMIN_TOKEN=root

# ── Dev helpers ───────────────────────────────────────────────────
# Set to true to enable in-process echo agent (for testing without agents/)
ECHO_AGENT_ENABLED=false
